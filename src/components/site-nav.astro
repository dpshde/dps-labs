---
import { isCurrentNav } from "../lib/nav";

const links = [
  { href: "/", label: "About" },
  { href: "/work/", label: "Work" },
  { href: "/music/", label: "Music" },
];

const pathname = Astro.url.pathname;
---

<nav aria-label="Main navigation">
  <div class="site-nav">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isCurrentNav(pathname, link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </div>
</nav>
