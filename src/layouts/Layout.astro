---
import "../styles/fonts.css";
import "../styles/global.css";
import SiteNav from "../components/site-nav.astro";
import SiteFooter from "../components/site-footer.astro";

interface Props {
  title: string;
  description: string;
  context: "about" | "work" | "music";
}

const { title, description, context } = Astro.props;
const siteUrl = "https://dpslabs.dev";
const canonical = new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en" data-rhythm-context={context}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/DPS LABS.png" />
    <link rel="apple-touch-icon" href="/images/DPS LABS.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <SiteNav />
      </header>
      <div class="site-main">
        <main id="content">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
    <script is:inline>
      window.addEventListener("load", function () {
        var script = document.createElement("script");
        script.src = "https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";
        script.async = true;
        script.onload = function () {
          window.mixpanel.init("4e7fa8ce2d7134d18dbdbe0ded5c1be9", {
            autocapture: false,
            record_sessions_percent: 0,
            track_pageview: true,
          });
        };
        document.body.appendChild(script);
      });
    </script>
  </body>
</html>
